[
 {
  "description": "获取运行中游戏的场景树结构",
  "inputSchema": {
   "properties": {
    "max_depth": {
     "default": -1,
     "description": "最大遍历深度，-1 表示无限",
     "type": "integer"
    },
    "named_only": {
     "default": false,
     "description": "是否只返回有名称的节点",
     "type": "boolean"
    },
    "script_filter": {
     "description": "按脚本路径过滤节点",
     "type": "string"
    },
    "type_filter": {
     "description": "按节点类型过滤（如 Node2D, Control）",
     "type": "string"
    }
   },
   "required": [],
   "type": "object"
  },
  "name": "running_game_get_scene_tree"
 },
 {
  "description": "获取运行中游戏指定节点的属性",
  "inputSchema": {
   "properties": {
    "node_path": {
     "description": "节点路径（相对于场景根节点）",
     "type": "string"
    },
    "properties": {
     "description": "要获取的属性列表（可选，不传则返回所有属性）",
     "items": {
      "type": "string"
     },
     "type": "array"
    }
   },
   "required": [
    "node_path"
   ],
   "type": "object"
  },
  "name": "running_game_get_node_properties"
 },
 {
  "description": "监控运行中游戏节点的属性随时间的变化",
  "inputSchema": {
   "properties": {
    "frame_count": {
     "default": 60,
     "description": "采集帧数",
     "type": "integer"
    },
    "frame_interval": {
     "default": 1,
     "description": "采集间隔帧数",
     "type": "integer"
    },
    "node_path": {
     "description": "节点路径",
     "type": "string"
    },
    "properties": {
     "description": "要监控的属性列表",
     "items": {
      "type": "string"
     },
     "type": "array"
    }
   },
   "required": [
    "node_path",
    "properties"
   ],
   "type": "object"
  },
  "name": "running_game_get_node_property_samples"
 },
 {
  "description": "批量获取多个节点的属性",
  "inputSchema": {
   "properties": {
    "nodes": {
     "description": "节点信息数组，每个元素包含 node_path 和可选的 properties",
     "items": {
      "properties": {
       "node_path": {
        "description": "节点路径",
        "type": "string"
       },
       "properties": {
        "description": "需要获取的属性",
        "items": {
         "type": "string"
        },
        "type": "array"
       }
      },
      "required": [
       "node_path"
      ],
      "type": "object"
     },
     "type": "array"
    }
   },
   "required": [
    "nodes"
   ],
   "type": "object"
  },
  "name": "running_game_get_node_properties_batch"
 },
 {
  "description": "获取自动加载节点的信息",
  "inputSchema": {
   "properties": {
    "name": {
     "description": "自动加载节点名称",
     "type": "string"
    },
    "properties": {
     "description": "需要获取的属性列表",
     "items": {
      "type": "string"
     },
     "type": "array"
    }
   },
   "required": [
    "name"
   ],
   "type": "object"
  },
  "name": "running_game_get_autoload_node"
 },
 {
  "description": "在运行中的游戏中按脚本路径查找节点",
  "inputSchema": {
   "properties": {
    "properties": {
     "description": "需要同时获取的属性列表",
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "script": {
     "description": "脚本路径（如 res://enemy.gd）",
     "type": "string"
    }
   },
   "required": [
    "script"
   ],
   "type": "object"
  },
  "name": "running_game_find_nodes_by_script"
 },
 {
  "description": "查找运行中游戏的所有 UI 元素",
  "inputSchema": {
   "properties": {
    "type_filter": {
     "description": "按控件类型过滤（如 Button, Label）",
     "type": "string"
    }
   },
   "required": [],
   "type": "object"
  },
  "name": "running_game_find_ui_elements"
 },
 {
  "description": "等待运行中游戏的指定节点出现",
  "inputSchema": {
   "properties": {
    "node_path": {
     "description": "要等待的节点路径",
     "type": "string"
    },
    "poll_frames": {
     "default": 5,
     "description": "每隔多少帧检查一次",
     "type": "integer"
    },
    "timeout": {
     "default": 5.0,
     "description": "超时时间（秒）",
     "type": "number"
    }
   },
   "required": [
    "node_path"
   ],
   "type": "object"
  },
  "name": "running_game_find_node_when_available"
 },
 {
  "description": "在运行中的游戏内执行 GDScript 代码",
  "inputSchema": {
   "properties": {
    "code": {
     "description": "要执行的 GDScript 代码",
     "type": "string"
    }
   },
   "required": [
    "code"
   ],
   "type": "object"
  },
  "name": "running_game_execute_gdscript"
 }
]